# Production build (npm run build → dist/, deployed to https://votefortruth.org/app/).
# Overrides .env; not secret.
VITE_NETWORK=testnet
# the indexer behind the same domain (Caddy: /api/* → vft-indexer)
VITE_API_URL=/api
