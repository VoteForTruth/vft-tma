# public address of the app: the TON Connect manifest is generated for it
VITE_APP_URL=https://votefortruth.org/app
VITE_MANIFEST_URL=https://votefortruth.org/app/tonconnect-manifest.json
VITE_APP_LINK=https://t.me/VoteForTruthBot
