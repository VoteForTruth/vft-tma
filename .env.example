# Copy to .env and adjust.
VITE_NETWORK=testnet
# indexer API (vft-indexer); in development /api is proxied to 127.0.0.1:8080
VITE_API_URL=/api
# VftMaster address, used to create root statements
VITE_MASTER=kQAtLOtQSvcqzpgpgmRoymv4BN5w5lcgF1VN6Ob0F4J0STiU
# public URL of tonconnect-manifest.json (wallets fetch it); in development
# the Vite server serves one for the current origin
# VITE_MANIFEST_URL=https://example.com/tonconnect-manifest.json
# Mini App link for sharing, e.g. https://t.me/VoteForTruthBot/app
# VITE_APP_LINK=
